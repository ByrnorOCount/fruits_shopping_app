        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.FavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.OrderHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminFruitActivity"
            android:exported="false" />
        <activity
            android:name=".ui.checkout.AddressActivity"
            android:exported="false" />
        <activity
            android:name=".ui.checkout.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminStatsActivity"
            android:exported="false" />
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image with dimming overlay -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:background="@color/black"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_main" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/leaf_green_top"
        android:theme="@style/Theme.Fruits_App.Toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:title="@string/select_payment_method"
        app:titleTextColor="@color/white" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#AAFFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/leaf_green_top"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <RadioGroup
            android:id="@+id/rgPaymentMethods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <RadioButton
                android:id="@+id/rbCreditCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/payment_credit_card"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:useMaterialThemeColors="false"
                app:buttonTint="@color/radio_tint" />

            <RadioButton
                android:id="@+id/rbPaypal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/payment_paypal"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:useMaterialThemeColors="false"
                app:buttonTint="@color/radio_tint" />

            <RadioButton
                android:id="@+id/rbCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/payment_cash"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                app:useMaterialThemeColors="false"
                app:buttonTint="@color/radio_tint" />

        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnConfirmPayment"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="24dp"
        android:backgroundTint="#802D5A27"
        android:text="@string/confirm_payment_method"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        app:strokeColor="@color/leaf_green_top"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>